# Kopiraj u .env.local i popuni. Na Vercel-u se iste varijable postavljaju u
# Project Settings -> Environment Variables.

# Groq API ključ za AI predlog termina (app/api/preneseni).
GROQ_API_KEY=

# Feedback forma (app/actions.ts) šalje mejl preko Resend-a.
RESEND_API_KEY=
FEEDBACK_EMAIL=
# Opciono, dok domen nije verifikovan ide onboarding@resend.dev.
RESEND_FROM_EMAIL=

# Javni VAPID ključ za Web Push (lib/push.ts).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Vercel Web Analytics. Samo tačno "true" renderuje <Analytics />, svaka druga
# vrednost (ili prazno) znači da se skript uopšte ne učitava. Vrednost se
# ugrađuje u kod pri build-u, pa promena traži novi deploy. Pre paljenja
# uključi i Web Analytics u Vercel dashboard-u, inače skript vraća 404.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Cloudflare Web Analytics token (Cloudflare -> Web Analytics -> Manage site ->
# token iz JS snippet-a). Prazno = skript se ne učitava. Ugrađuje se pri
# build-u, pa promena traži novi deploy.
NEXT_PUBLIC_CF_BEACON_TOKEN=
